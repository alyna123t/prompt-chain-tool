# Copy to .env.local and fill in the SAME Supabase values as the existing apps
# (hello_world / vibes-admin). Find them in that project's Vercel settings, or in
# Supabase > Project Settings > API. Reusing the same project means the same Google
# login and the same profiles.is_superadmin flag work here too.
#
# Access is enforced by Supabase RLS + the is_superadmin check, so only the public
# anon key is needed — no service-role key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — enables REAL AI generation for the "Generate media" step.
# Without it, the tool still works but produces clearly-labeled mock output.
# Get a key at https://console.anthropic.com/ > Settings > API Keys.
ANTHROPIC_API_KEY=

# Optional — override the model used for generation (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
